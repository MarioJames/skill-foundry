**/tests/

# Ship the browser acceptance CLI, evidence, and lifecycle contract.
!skills/browser-harness/tests/
skills/browser-harness/tests/*
!skills/browser-harness/tests/browser-harness.test.ts

# Ship behavioral regression coverage for ChatGPT coordination.
!skills/chatgpt-review/tests/

# Ship maintained acceptance checks without adding unrelated local test fixtures.
!skills/asset-validation/tests/
skills/asset-validation/tests/*
!skills/asset-validation/tests/cli-default.test.ts
!skills/asset-validation/tests/docs.test.ts

# Keep unrelated local Herdr fixtures private.
!skills/herdr/tests/
skills/herdr/tests/*
!skills/herdr/tests/caller-identity.test.ts
!skills/herdr/tests/codex-session.test.ts

# Ship the public DEV discovery and foreground lifecycle contract.
!skills/public-acceptance/tests/
skills/public-acceptance/tests/*
!skills/public-acceptance/tests/dev-process.test.ts

# Ship independent dispatch protocol and admission contracts.
!skills/agent-dispatch/tests/
skills/agent-dispatch/tests/*
!skills/agent-dispatch/tests/*.test.ts
!skills/agent-dispatch/tests/fixtures/
!skills/agent-dispatch/tests/fixtures/*.ts

# Ship the feature acceptance scan and rule evolution contract.
!skills/feature-acceptance/tests/
skills/feature-acceptance/tests/*
!skills/feature-acceptance/tests/accept.test.ts

# Ship the real-VM lifecycle contract for clean Debian test machines.
!skills/debian-testvm/tests/
skills/debian-testvm/tests/*
!skills/debian-testvm/tests/testvm.test.ts
!skills/debian-testvm/tests/doctor.test.ts
