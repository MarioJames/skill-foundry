{
  "version": 1,
  "manual_override": null,
  "engines": {
    "example-qoder": {
      "adapter": "qodercli",
      "max_parallel": 1
    },
    "example-codex": {
      "adapter": "codex",
      "max_parallel": 2
    }
  },
  "routes": {
    "ordinary": {
      "engine_id": "example-codex",
      "model": "gpt-6-luna",
      "reasoning": {
        "mode": "effort",
        "value": "max"
      }
    },
    "moderate": {
      "engine_id": "example-codex",
      "model": "gpt-6-astra",
      "reasoning": {
        "mode": "effort",
        "value": "medium"
      }
    },
    "complex": {
      "engine_id": "example-codex",
      "model": "gpt-6-astra",
      "reasoning": {
        "mode": "effort",
        "value": "high"
      }
    }
  },
  "limits": {
    "max_parallel": 3
  }
}
