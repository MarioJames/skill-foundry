{
  "version": 1,
  "manual_override": null,
  "engines": {
    "example-qoder": {
      "adapter": "qodercli",
      "max_parallel": 1
    },
    "example-codex": {
      "adapter": "codex",
      "max_parallel": 2
    },
    "example-claude": {
      "adapter": "claude",
      "max_parallel": 1
    }
  },
  "routes": {
    "ordinary": {
      "engine_id": "example-codex",
      "model": "gpt-6.1-sol",
      "reasoning": {
        "mode": "effort",
        "value": "medium"
      }
    },
    "moderate": {
      "engine_id": "example-codex",
      "model": "gpt-6.1-sol",
      "reasoning": {
        "mode": "effort",
        "value": "high"
      }
    },
    "complex": {
      "engine_id": "example-claude",
      "model": "claude-opus-5-5",
      "reasoning": {
        "mode": "effort",
        "value": "high"
      }
    }
  },
  "limits": {
    "max_parallel": 3
  }
}
