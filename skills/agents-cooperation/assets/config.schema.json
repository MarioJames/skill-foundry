{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agents-cooperation config",
  "description": "Owner agent scheduling config. Structure lives here; cross-object rules (references, kind-specific effort sets, one enabled owner per engine, parallel limits) are enforced by scripts/agents-config.ts validate.",
  "type": "object",
  "required": [
    "version",
    "engines",
    "owners",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "engines": {
      "description": "Agent CLI engines keyed by engine id.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/engine"
      }
    },
    "owners": {
      "description": "Owner agents keyed by owner id. Each enabled engine has at most one enabled owner.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/owner"
      }
    },
    "agents": {
      "description": "Sub-agents keyed by agent id; every id ends with _worker, regardless of class.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,32}_worker$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,32}_worker$"
    },
    "effort": {
      "description": "Engine-native effort. Allowed set depends on the engine kind: claude low|medium|high|xhigh|max; codex minimal|low|medium|high|xhigh|max; pi off|minimal|low|medium|high|xhigh|max; grok none|minimal|low|medium|high|xhigh|max; other kinds any non-empty string. Checked by the script.",
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "required": [
        "enabled",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "description": "A herdr agent start --kind value.",
          "enum": [
            "pi",
            "claude",
            "codex",
            "gemini",
            "cursor",
            "devin",
            "agy",
            "cline",
            "omp",
            "mastracode",
            "opencode",
            "copilot",
            "kimi",
            "kiro",
            "droid",
            "amp",
            "grok",
            "hermes",
            "kilo",
            "qodercli",
            "qwen",
            "letta",
            "maki",
            "muse"
          ]
        },
        "native_subagents": {
          "description": "Whether the engine can spawn sub-agents natively. Only claude, codex and grok can.",
          "type": "boolean"
        }
      },
      "if": {
        "required": [
          "native_subagents"
        ],
        "properties": {
          "native_subagents": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "claude",
              "codex",
              "grok"
            ]
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "enabled",
        "engine",
        "model",
        "effort",
        "workers",
        "max_parallel"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "engine": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "workers": {
          "description": "Sub-agent ids in priority order; may mix class worker and task.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/agentId"
          }
        },
        "max_parallel": {
          "description": "Cap on sub-agents (worker and task) running concurrently for this owner; the owner enforces it by counting running ledger entries.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "enabled",
        "engine",
        "class",
        "model",
        "effort"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "engine": {
          "$ref": "#/$defs/id"
        },
        "class": {
          "enum": [
            "worker",
            "task"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
