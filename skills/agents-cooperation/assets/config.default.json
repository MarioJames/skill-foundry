{
  "$schema": "./config.schema.json",
  "version": 1,
  "engines": {
    "claude": { "enabled": true, "kind": "claude", "native_subagents": true },
    "codex": { "enabled": true, "kind": "codex", "native_subagents": true },
    "grok": { "enabled": false, "kind": "grok", "native_subagents": false },
    "opencode": { "enabled": false, "kind": "opencode", "native_subagents": false },
    "qoder": { "enabled": false, "kind": "qodercli", "native_subagents": false }
  },
  "owners": {
    "claude_owner": {
      "enabled": true,
      "engine": "claude",
      "model": "claude-opus-5-5",
      "effort": "high",
      "workers": ["claude_worker", "qoder_worker", "opencode_worker", "codex_worker", "grok_worker"],
      "max_parallel": 4
    },
    "codex_owner": {
      "enabled": true,
      "engine": "codex",
      "model": "gpt-6-astra",
      "effort": "high",
      "workers": ["codex_worker", "qoder_worker", "opencode_worker", "claude_worker", "grok_worker"],
      "max_parallel": 4
    }
  },
  "workers": {
    "claude_worker": { "enabled": true, "engine": "claude", "model": "sonnet", "effort": "high", "tags": ["frontend", "ui", "browser", "docs"], "description": "Default worker for Claude Code; suited to frontend, UI, browser and docs work." },
    "codex_worker": { "enabled": true, "engine": "codex", "model": "gpt-6.1-sol", "effort": "high", "tags": ["backend", "algorithm", "test", "refactor"], "description": "Default worker for Codex; suited to backend, algorithm, test and refactor work." },
    "grok_worker": { "enabled": false, "engine": "grok", "model": "grok-4.7", "effort": "high", "tags": ["research"], "description": "Example worker for Grok; suited to research." },
    "qoder_worker": { "enabled": false, "engine": "qoder", "model": "Qwen3.8-Flash", "effort": "xhigh", "tags": ["routine", "test", "lint", "scaffold"], "description": "Free worker (Qwen3.8-Flash via qodercli); prefer it for routine implementation whose plan is frozen and write scope is explicit." },
    "opencode_worker": { "enabled": false, "engine": "opencode", "model": "opencode/glm-5.3-flash-free", "effort": "max", "tags": ["mechanical", "test", "lint", "sweep"], "description": "Free worker (glm-5.3-flash-free via opencode); prefer it for rule-bound edits, test runs, lint fixes and read-only sweeps. Its TUI uses the variant remembered in ~/.local/state/opencode/model.json, which must match effort." }
  }
}
