{
  "$schema": "./config.schema.json",
  "version": 1,
  "engines": {
    "claude": { "enabled": true, "kind": "claude", "native_subagents": true },
    "codex": { "enabled": true, "kind": "codex", "native_subagents": true },
    "pi": { "enabled": false, "kind": "pi", "native_subagents": false },
    "grok": { "enabled": false, "kind": "grok", "native_subagents": true }
  },
  "owners": {
    "claude_owner": {
      "enabled": true,
      "engine": "claude",
      "model": "claude-opus-5-5",
      "effort": "high",
      "workers": ["claude_worker", "codex_worker", "pi_worker"],
      "max_parallel": 3
    },
    "codex_owner": {
      "enabled": true,
      "engine": "codex",
      "model": "gpt-6-astra",
      "effort": "high",
      "workers": ["codex_worker", "claude_worker", "pi_worker"],
      "max_parallel": 3
    },
    "grok_owner": {
      "enabled": false,
      "engine": "grok",
      "model": "grok-4.7",
      "effort": "high",
      "workers": ["grok_worker", "claude_worker", "codex_worker"],
      "max_parallel": 3
    }
  },
  "agents": {
    "claude_worker": { "enabled": true, "engine": "claude", "class": "worker", "model": "sonnet", "effort": "high", "description": "Default worker for Claude Code." },
    "codex_worker": { "enabled": true, "engine": "codex", "class": "worker", "model": "gpt-6.1-sol", "effort": "high", "description": "Default worker for Codex." },
    "pi_worker": { "enabled": false, "engine": "pi", "class": "task", "model": "cc-switch-agentplan/deepseek-v4.1-flash", "effort": "medium", "description": "Example one-shot task agent for rule-bound edits and read-only sweeps." },
    "grok_worker": { "enabled": false, "engine": "grok", "class": "worker", "model": "grok-4.7", "effort": "high", "description": "Example worker for Grok." }
  }
}
